# Copy this file to .env and replace every required placeholder.
# Never commit the resulting .env file.

# Database
POSTGRES_USER=jobway
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=jobway
DATABASE_URL=postgresql://jobway:YOUR_PASSWORD@localhost:5432/jobway
DIRECT_URL=postgresql://jobway:YOUR_PASSWORD@localhost:5432/jobway

# Hono backend
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JOBWAY_TRUST_PROXY=0

# Administrative APIs remain disabled when this is empty.
ADMIN_API_TOKEN=

# Isolated code executor
EXECUTOR_URL=http://localhost:8080
EXECUTOR_TOKEN=replace-with-at-least-32-random-characters

# Optional AI pipeline
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
FEEDER_API_URL=http://localhost:3000

# FastAPI placement service
JOBWAY_ENV=development
JOBWAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JOBWAY_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
JOBWAY_ADMIN_TOKEN=
JOBWAY_EXECUTOR_URL=http://localhost:8080
JOBWAY_EXECUTOR_TOKEN=replace-with-at-least-32-random-characters
JOBWAY_ENABLE_UNSAFE_LOCAL_EXECUTION=0
JOBWAY_ENABLE_PIPELINE_SCHEDULER=0

# Frontend (set these in Vercel only when the APIs are deployed)
VITE_API_BASE=
VITE_PLACEMENT_API=
